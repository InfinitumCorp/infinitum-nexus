# Canonical Cumulus domain. Hosted on Cloudflare. Addresses are name@CUMULUS_ROOT_DOMAIN.
# Hosts must be the root domain or one of its subdomains. Wildcards are rejected.
# Infinitum Corporation®. Do not put passwords, API tokens, or master keys in this file.
CUMULUS_ROOT_DOMAIN=cumuluscloud.app
# Cumulus://ID host. Issuer is https://$CUMULUS_ID_HOST/realms/$CUMULUS_KEYCLOAK_REALM
CUMULUS_ID_HOST=id.cumuluscloud.app
# Keycloak realm. Issuer: https://id.cumuluscloud.app/realms/cumulus
# JWKS: https://id.cumuluscloud.app/realms/cumulus/protocol/openid-connect/certs
CUMULUS_KEYCLOAK_REALM=cumulus
# Cumulus://Cloud
CUMULUS_CLOUD_HOST=cloud.cumuluscloud.app
# Cumulus://Mail web host. Mail addresses stay on the root domain.
CUMULUS_MAIL_HOST=mail.cumuluscloud.app
# Upstream mode for Cumulus://Mail (and any product built on @infinitum/cumulus): the issuer origin.
# When set, the product never creates a Cumulus://ID itself; people sign in at the issuer and the
# product keeps a local mirror under the issuer's cid. Leave unset to keep the old behavior.
# CUMULUS_ID_ISSUER=https://id.cumuluscloud.app

# +SPCTR public origin. Passkeys are bound to this exact URL.
SPECTRE_ORIGIN=https://id.cumuluscloud.app
# Shared nexus-store (Infinitum Corp Supabase project). The gateway key is a secret:
#   npx wrangler secret put NEXUS_STORE_KEY
# Do not put the key in this file.
NEXUS_STORE_URL=https://ivqiskeziohbbtkcvlun.supabase.co/functions/v1/nexus-store
# NEXUS_STORE_KEY=

# Optional Amazon Cognito sign-in for Cumulus://ID (Lite or Essentials). Off unless every
# variable is set. Plus has no free MAU. Leave SMS MFA and SES email disabled; use TOTP
# if a second factor is wanted. Domain is the hosted UI prefix or a custom https hostname.
# COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_yourPoolId
# OpenID Connect signing key for id.cumuluscloud.app (private JWK JSON, ES256 or Ed25519).
# Leave it unset and OIDC stays off: passkey, Google, and Cognito sign-in still work.
# Generate a file without printing the private key:
#   node apps/spectre/scripts/generate-oidc-key.mjs oidc-signing-key.jwk
# Then: npx wrangler secret put CID_OIDC_SIGNING_KEY < oidc-signing-key.jwk
# CID_OIDC_SIGNING_KEY=

# Drive storage. The database password belongs in the real environment, not here.
# CUMULUS_CLOUD_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/cloud
# CUMULUS_CLOUD_DATA_DIR=./data
# CUMULUS_CLOUD_DRIVER=local

# AI: free open-weight models, switched automatically (packages/ai).
# Local: OmniRoute -> Ollama on this machine. The "infinitum-open" combo lists the local models. No key needed.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_SMART_MODEL=infinitum-open
# Deployed Workers: declare the AI binding ("ai": {"binding": "AI"}) and add workersAiProvider(env.AI);
# Cloudflare's free daily allowance, no token.

# @conjure: hosted Conjure prediction service (key from the Conjure staff dashboard; server-side only)
CONJURE_URL=
CONJURE_PRODUCT_KEY=

# SCALVS agent on OpenClaw (@scalvs / @scalus in chat/Ask boxes): off until both are set. The token is a server secret.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_AGENT=openclaw

# Exa web search: startup credits, key is server-only. Active whenever the key exists.
EXA_API_KEY=
# EXA_SEARCH=off
