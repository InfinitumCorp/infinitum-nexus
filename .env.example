# Canonical Cumulus domain. Hosted on Cloudflare. Addresses are name@CUMULUS_ROOT_DOMAIN.
# Hosts must be the root domain or one of its subdomains. Wildcards are rejected.
# Infinitum Corporation®. Do not put passwords, API tokens, or master keys in this file.
CUMULUS_ROOT_DOMAIN=cumuluscloud.app
# Cumulus://ID host. Issuer is https://$CUMULUS_ID_HOST/realms/$CUMULUS_KEYCLOAK_REALM
CUMULUS_ID_HOST=id.cumuluscloud.app
# Keycloak realm. Issuer: https://id.cumuluscloud.app/realms/cumulus
# JWKS: https://id.cumuluscloud.app/realms/cumulus/protocol/openid-connect/certs
CUMULUS_KEYCLOAK_REALM=cumulus
# Cumulus://Cloud
CUMULUS_CLOUD_HOST=cloud.cumuluscloud.app
# Cumulus://Mail web host. Mail addresses stay on the root domain.
CUMULUS_MAIL_HOST=mail.cumuluscloud.app

# Drive storage. The database password belongs in the real environment, not here.
# CUMULUS_CLOUD_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/cloud
# CUMULUS_CLOUD_DATA_DIR=./data
# CUMULUS_CLOUD_DRIVER=local

# AI: free open-weight models, switched automatically (packages/ai).
# Local: OmniRoute -> Ollama on this machine. The "infinitum-open" combo lists the local models. No key needed.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_SMART_MODEL=infinitum-open
# Deployed Workers: declare the AI binding ("ai": {"binding": "AI"}) and add workersAiProvider(env.AI);
# Cloudflare's free daily allowance, no token.

# @conjure: hosted Conjure prediction service (key from the Conjure staff dashboard; server-side only)
CONJURE_URL=
CONJURE_PRODUCT_KEY=
