# cumuluscloud.app is the Infinitum Corporation® domain for Cumulus://ID,
# Cumulus://Cloud, and Cumulus://Mail. DNS and HTTPS are on Cloudflare.
# These values match the defaults in packages/cid/src/domain.ts.
# Copy to .env only on a machine that runs a service. Do not commit .env.
# Do not put passwords, API tokens, or master keys in this file.

CUMULUS_DOMAIN=cumuluscloud.app
CUMULUS_MAIL_DOMAIN=cumuluscloud.app
CUMULUS_ID_HOST=id.cumuluscloud.app
CUMULUS_CLOUD_HOST=cloud.cumuluscloud.app
CUMULUS_MAIL_HOST=mail.cumuluscloud.app
CUMULUS_ID_ORIGIN=https://id.cumuluscloud.app
CUMULUS_CLOUD_ORIGIN=https://cloud.cumuluscloud.app
CUMULUS_MAIL_ORIGIN=https://mail.cumuluscloud.app
CUMULUS_ISSUER=https://id.cumuluscloud.app
CUMULUS_COOKIE_DOMAIN=.cumuluscloud.app

# Local servers keep passkeys on localhost until these are set to the public origins.
# MAIL_ORIGIN=https://mail.cumuluscloud.app
# SPECTRE_ORIGIN=https://id.cumuluscloud.app

# Drive storage. The database password belongs in the real environment, not here.
# CUMULUS_CLOUD_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/cloud
# CUMULUS_CLOUD_DATA_DIR=./data
# CUMULUS_CLOUD_DRIVER=local
