{
  // Cumulus://Mail downloads: the page at downloads.cumuluscloud.app plus the installers, streamed
  // from the private R2 bucket cumulus-downloads (nothing in the bucket is public on its own).
  // Deploy: cd apps/cumulus-mail/downloads && npx wrangler deploy
  // Publish installers: node publish.mjs <folder with the built files>
  "name": "cumulus-downloads",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/files/*", "/get/*"] },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "cumulus-downloads" }],
  "routes": [{ "pattern": "downloads.cumuluscloud.app", "custom_domain": true }],
  "observability": { "enabled": true }
}
