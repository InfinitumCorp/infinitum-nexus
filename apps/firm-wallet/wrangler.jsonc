{
  // $FIRM Wallet™ app. Runs on the Workers free plan. Not deployed yet: add the custom domain
  // (e.g. app.firmwallet.app) under "routes" when it's approved to go live.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firm-wallet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
  // Optional Conjure swarm (paid model calls): set CONJURE_URL as a var and
  // CONJURE_KEY with `npx wrangler secret put CONJURE_KEY`.
}
