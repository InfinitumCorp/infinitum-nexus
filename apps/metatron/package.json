{
  "name": "@infinitum/metatron-app",
  "version": "0.1.0",
  "description": "METATRON server: linked bank and brokerage accounts (Plaid), broker trading (Alpaca) behind guardrails and approvals, every action on Firmament.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types $(find src -name \"*.test.ts\" 2>/dev/null || true)"
  },
  "dependencies": {
    "@infinitum/cid": "workspace:*",
    "@infinitum/firmament": "workspace:*",
    "@infinitum/metatron": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
