{
  "name": "@infinitum/spectre",
  "version": "0.1.0",
  "description": "+SPCTR (Spectre): Infinitum's AI-powered intelligent CRM.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/main.ts",
