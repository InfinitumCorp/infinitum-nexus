    "@infinitum/cumulus": "workspace:*",
    "@infinitum/drone-backend": "workspace:*",
    "@infinitum/firmament": "workspace:*",
    "@infinitum/lbrnth": "workspace:*",
    "@infinitum/lbrnth-client": "workspace:*",
    "@infinitum/metatron": "workspace:*",
    "@infinitum/scalus": "workspace:*",
    "@infinitum/veil": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
