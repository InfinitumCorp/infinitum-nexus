    "@infinitum/architect": "workspace:*",
    "@infinitum/conjure": "workspace:*",
    "@infinitum/cumulus": "workspace:*",
    "@infinitum/metatron": "workspace:*",
    "@infinitum/scalus": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
