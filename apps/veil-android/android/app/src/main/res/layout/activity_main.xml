<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/wordmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/wordmark"
            android:textColor="#1A1A1A"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/limits"
            android:textColor="#1A1A1A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/status_label"
            android:paddingBottom="20dp"
            android:textColor="#1A1A1A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/operator_heading"
            android:textColor="#1A1A1A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/endpoint"
            android:text="@string/endpoint_label"
            android:textColor="#1A1A1A" />

        <EditText
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/endpoint_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/peer_public"
            android:text="@string/public_label"
            android:textColor="#1A1A1A" />

        <EditText
            android:id="@+id/peer_public"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/public_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/private_key"
            android:text="@string/private_label"
            android:textColor="#1A1A1A" />

        <EditText
            android:id="@+id/private_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/private_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:textColor="#1A1A1A" />

        <CheckBox
            android:id="@+id/geo_routing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/geo_routing"
            android:textColor="#1A1A1A" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/connect"
            android:text="@string/connect" />

        <Button
            android:id="@+id/disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/disconnect"
            android:text="@string/disconnect" />

        <LinearLayout
            android:id="@+id/debug_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp" />
    </LinearLayout>
</ScrollView>
