{
  "manifest_version": 3,
  "name": "VEIL</>™",
  "version": "0.3.4",
  "description": "Tor-first secure browser sidebar: private browsing, AI assistant, and Infinitum ecosystem access.",
  "permissions": ["sidePanel", "storage", "activeTab", "tabs", "proxy"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Open VEIL sidebar",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg"
    }
  },
  "icons": {
    "48": "icon.svg"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
