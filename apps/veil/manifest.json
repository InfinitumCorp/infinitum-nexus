{
  "manifest_version": 3,
  "name": "VEIL</>™",
  "version": "0.4.3",
  "description": "Tor-first secure browser sidebar: private browsing, AI assistant, and Infinitum ecosystem access.",
  "permissions": ["sidePanel", "storage", "activeTab", "tabs", "proxy"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Open VEIL sidebar",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["deployed.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
