# Copy to .env (git-ignored) and fill in. Generate random values, e.g.:
#   python -c "import secrets;print(secrets.token_hex(32))"
# Never commit the filled-in file: this repository is public.

# Service token products use to call the privacy gateway (32+ chars).
PRIVACY_GATEWAY_TOKEN=
# Key for analytics pseudonyms (32+ bytes). Rotating it breaks joins with older pseudonyms.
PRIVACY_PSEUDONYM_KEY=
# Total epsilon per dataset across all DP releases.
PRIVACY_TOTAL_EPSILON=3.0

# Superset (profile "bi")
SUPERSET_SECRET_KEY=
SUPERSET_DB_PASSWORD=
# Sign in with Cumulus ID. Register a confidential OIDC client at id.cumuluscloud.app with
# redirect URI http://localhost:8088/oauth-authorized/cumulus
CUMULUS_ID_ISSUER=https://id.cumuluscloud.app/realms/cumulus
CUMULUS_ID_CLIENT_ID=
CUMULUS_ID_CLIENT_SECRET=
CUMULUS_ID_SIGNUP_URL=https://id.cumuluscloud.app/signup
# Space-separated origins allowed to embed dashboards, e.g. https://spectre.example
CUMULUS_EMBED_ORIGINS=
