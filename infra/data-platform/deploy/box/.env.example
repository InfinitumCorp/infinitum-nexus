# Copy to .env next to this file (git-ignored) and fill in on the box. Never commit it.
# Random values: python -c "import secrets;print(secrets.token_hex(32))"

PRIVACY_GATEWAY_TOKEN=
PRIVACY_PSEUDONYM_KEY=
PRIVACY_TOTAL_EPSILON=3.0
# spectre=<token>;cumulus-mail=<token>   (quote the value if your shell sources this file)
PLATFORM_PRODUCT_TOKENS=

# Supabase (Ireland) session pooler as the data_platform_gateway role, with TLS, e.g.
# postgresql://data_platform_gateway.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Free-tier guards (defaults shown). New events are refused with 503 at the storage limit and
# with 429 once a product reaches its daily quota; products keep and resend them.
PLATFORM_STORAGE_LIMIT_MB=450
PLATFORM_DAILY_EVENT_QUOTA=200000
PLATFORM_MAX_BATCH=1000

# Optional: DataHub GMS when the on-demand quickstart is running.
DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN=

SUPERSET_SECRET_KEY=
SUPERSET_DB_PASSWORD=
CUMULUS_ID_ISSUER=https://id.cumuluscloud.app/realms/cumulus
CUMULUS_ID_CLIENT_ID=
CUMULUS_ID_CLIENT_SECRET=
CUMULUS_ID_SIGNUP_URL=https://id.cumuluscloud.app/signup
CUMULUS_EMBED_ORIGINS=
# Embedded dashboards: one random secret shared by the gateway and Superset, and the embedded
# dashboard UUIDs each product may show, e.g. spectre=<uuid>,<uuid>;fabric=<uuid>
SUPERSET_GUEST_TOKEN_SECRET=
PLATFORM_EMBED_DASHBOARDS=

# From Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > token.
CLOUDFLARE_TUNNEL_TOKEN=
