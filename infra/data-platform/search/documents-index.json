{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "product": { "type": "keyword" },
      "collection": { "type": "keyword" },
      "tenant": { "type": "keyword" },
      "documentId": { "type": "keyword" },
      "title": { "type": "text" },
      "body": { "type": "text" },
      "url": { "type": "keyword", "index": false },
      "labels": { "type": "keyword" },
      "ownerCid": { "type": "keyword" },
      "viewers": { "type": "keyword" },
      "restricted": { "type": "boolean" },
      "updatedAt": { "type": "date" },
      "expiresAt": { "type": "date" }
    }
  }
}
