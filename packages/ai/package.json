{
  "name": "@infinitum/ai",
  "version": "0.1.0",
  "description": "Open-weight model router for every Infinitum backend: one chat API, instant automatic switching between models and hosts.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types $(find src -name \"*.test.ts\" 2>/dev/null || true)"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^26.6.6"
  }
}
