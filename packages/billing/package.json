{
  "name": "@infinitum/billing",
  "version": "0.1.0",
  "description": "Client for the Infinitum revenue API (Stripe Checkout, billing portal, metered usage, credits) and the link between a Cumulus://ID and its billing org.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types $(find src -name \"*.test.ts\" 2>/dev/null || true)"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@infinitum/geo-dat": "workspace:*"
  }
}
