{
  "name": "@infinitum/cloud",
  "version": "0.1.0",
  "description": "Cumulus://Cloud Drive: local file storage and Postgres metadata for Infinitum Corporation®.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./drive": "./src/drive/index.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types $(find src -name \"*.test.ts\" 2>/dev/null || true)"
  },
  "dependencies": {
    "@infinitum/cid": "workspace:*",
    "@infinitum/firmament": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5"
  }
}
