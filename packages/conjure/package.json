{
  "name": "@infinitum/conjure",
  "version": "0.1.0",
  "description": "Conjure\u2122: swarm prediction built into every Infinitum product. A swarm of AI agents plays out a question so you can read the likely outcome.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./markets": "./src/markets.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@infinitum/ai": "workspace:*",
    "@infinitum/scalus": "workspace:*",
    "@infinitum/lbrnth-client": "workspace:*",
    "@infinitum/metatron": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types $(find src -name \"*.test.ts\" 2>/dev/null || true)"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
