{
  "name": "@infinitum/ui",
  "version": "0.1.0",
  "description": "Shared app shell for every Infinitum product app: one layout, the brand tokens from RULES, and each product's own wordmark.",
  "type": "module",
  "private": true,
  "exports": {
    "./app-shell.css": "./app-shell.css",
    "./shell.html": "./shell.html"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "test": "node --test --experimental-strip-types $(find src -name \"*.test.ts\" 2>/dev/null || true)"
  },
  "dependencies": {
    "@infinitum/geo-dat": "workspace:*"
  }
}
